# Supabase — the admin panel's database, image storage and logins.
# Copy to .env.local for development, and add the same three to the
# Netlify site's environment variables. Without them the site runs on its
# bundled content and /admin opens as a read-only preview.

# Project URL (Supabase → Project Settings → API)
SUPABASE_URL=
# The public "anon" / publishable key: safe to be known, row-level security applies
SUPABASE_ANON_KEY=
# The service_role / secret key: server only, never in client code or VITE_ vars
SUPABASE_SERVICE_ROLE_KEY=